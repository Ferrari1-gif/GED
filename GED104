          <h4 class="font-bold text-sm text-white border-b border-slate-800 pb-2 flex items-center gap-2">
            <i data-lucide="sliders" class="w-4 h-4 text-solar-400"></i> Environmental Controls
          </h4>

          <!-- Solar Cycle Control -->
          <div class="space-y-2">
            <div class="flex justify-between text-xs">
              <span class="text-slate-400">Solar Cycle Mode:</span>
              <span id="txt-solar-mode" class="font-bold text-solar-400">Peak Sun (12:00 PM)</span>
            </div>
            <div class="grid grid-cols-2 gap-2">
              <button onclick="setSolarMode('day')" id="btn-mode-day" class="text-xs py-2 rounded-lg bg-solar-500/20 border border-solar-500/40 text-solar-300 font-semibold flex items-center justify-center gap-2">
                <i data-lucide="sun" class="w-4 h-4"></i> Day (Peak Solar)
              </button>
              <button onclick="setSolarMode('night')" id="btn-mode-night" class="text-xs py-2 rounded-lg bg-slate-900 border border-slate-800 text-slate-400 hover:text-white flex items-center justify-center gap-2">
                <i data-lucide="moon" class="w-4 h-4"></i> Night (PCM Storage)
              </button>
            </div>
          </div>

          <!-- Ambient Temp Slider -->
          <div class="space-y-2">
            <div class="flex justify-between text-xs">
              <span class="text-slate-400">Ambient Temperature:</span>
              <span id="lbl-ambient-temp" class="font-bold text-white">32 °C</span>
            </div>
            <input type="range" id="input-ambient" min="20" max="42" value="32" oninput="updateSimControls()" class="w-full accent-agri-500 cursor-pointer" />
            <div class="flex justify-between text-[10px] text-slate-500">
              <span>20°C (Benguet)</span>
              <span>42°C (Summer Manila)</span>
            </div>
          </div>

          <!-- Cargo Load Weight Slider -->
          <div class="space-y-2">
            <div class="flex justify-between text-xs">
              <span class="text-slate-400">Cargo Crop Load:</span>
              <span id="lbl-cargo-load" class="font-bold text-white">50 kg</span>
            </div>
            <input type="range" id="input-cargo" min="10" max="150" value="50" oninput="updateSimControls()" class="w-full accent-agri-500 cursor-pointer" />
            <div class="flex justify-between text-[10px] text-slate-500">
              <span>10 kg (Batch Sample)</span>
              <span>150 kg (Full Module Capacity)</span>
            </div>
          </div>

          <!-- PCM Battery Thermal Boost Toggle -->
          <div class="pt-2 border-t border-slate-800 flex items-center justify-between">
            <div>
              <div class="text-xs font-semibold text-white">PCM Battery Phase Activation</div>
              <div class="text-[11px] text-slate-400">Salt-hydrate passive discharge</div>
            </div>
            <label class="relative inline-flex items-center cursor-pointer">
              <input type="checkbox" id="chk-pcm" checked onchange="updateSimControls()" class="sr-only peer">
              <div class="w-11 h-6 bg-slate-800 peer-focus:outline-none rounded-full peer peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:border-slate-300 after:border after:rounded-full after:h-5 after:w-5 after:transition-all peer-checked:bg-agri-600"></div>
            </label>
          </div>

        </div>

        <!-- Real-Time Metrics Gauge Panel -->
        <div class="lg:col-span-2 space-y-6">
          
          <div class="grid grid-cols-2 sm:grid-cols-4 gap-4">
            
            <!-- Solar Power Wattage -->
            <div class="glass-panel p-4 rounded-xl border border-slate-800 space-y-1">
              <div class="flex justify-between items-center text-slate-400 text-xs">
                <span>Solar Output</span>
                <i data-lucide="sun" class="w-4 h-4 text-solar-400"></i>
              </div>
              <div id="metric-solar" class="text-2xl font-black text-solar-400">180 W</div>
              <div class="text-[10px] text-slate-500">12V Monocrystalline</div>
            </div>

            <!-- Internal Storage Temp -->
            <div class="glass-panel p-4 rounded-xl border border-slate-800 space-y-1">
              <div class="flex justify-between items-center text-slate-400 text-xs">
                <span>Internal Temp</span>
                <i data-lucide="thermometer" class="w-4 h-4 text-agri-400"></i>
              </div>
              <div id="metric-internal-temp" class="text-2xl font-black text-agri-400">4.8 °C</div>
              <div id="status-target" class="text-[10px] text-emerald-400 font-medium">Optimal (2°C - 8°C)</div>
            </div>

            <!-- PCM Battery Charge State -->
            <div class="glass-panel p-4 rounded-xl border border-slate-800 space-y-1">
              <div class="flex justify-between items-center text-slate-400 text-xs">
                <span>PCM Thermal State</span>
                <i data-lucide="battery-charging" class="w-4 h-4 text-blue-400"></i>
              </div>
              <div id="metric-pcm-state" class="text-lg font-bold text-blue-400">Solid / 88%</div>
              <div class="text-[10px] text-slate-500">Salt-Hydrate Buffer</div>
            </div>

            <!-- Total System Power Draw -->
            <div class="glass-panel p-4 rounded-xl border border-slate-800 space-y-1">
              <div class="flex justify-between items-center text-slate-400 text-xs">
                <span>Peltier Core Draw</span>
                <i data-lucide="zap" class="w-4 h-4 text-amber-400"></i>
              </div>
              <div id="metric-power-draw" class="text-2xl font-black text-amber-400">65 W</div>
              <div class="text-[10px] text-slate-500">Dual-Stage Solid State</div>
            </div>

          </div>

          <!-- Chart Visualizer -->
          <div class="glass-panel p-5 rounded-xl border border-slate-800 space-y-3">
            <div class="flex items-center justify-between">
              <h4 class="font-bold text-sm text-white flex items-center gap-2">
                <i data-lucide="line-chart" class="w-4 h-4 text-agri-500"></i> Live Thermal Telemetry Stream
              </h4>
              <span class="text-[11px] text-slate-400">Updates every 1.5 seconds</span>
            </div>
            <div class="h-56 relative">
              <canvas id="telemetryChart"></canvas>
            </div>
          </div>

        </div>

      </div>

      <!-- LoRa Mesh Network Telemetry Visualizer -->
      <div class="glass-panel p-6 rounded-xl border border-slate-800 space-y-4">
        <div class="flex flex-wrap items-center justify-between gap-2 border-b border-slate-800 pb-3">
          <div>
            <h4 class="font-bold text-base text-white flex items-center gap-2">
              <i data-lucide="network" class="text-solar-400"></i> Off-Grid LoRa Mesh Micro-Logistics Visualizer
            </h4>
            <p class="text-xs text-slate-400">Real-time radio telemetry packet broadcasting between Benguet farm nodes and transport hub.</p>
          </div>
          <span class="bg-solar-500/20 text-solar-300 text-xs px-2.5 py-1 rounded-full font-mono border border-solar-500/30 flex items-center gap-1">
            <span class="w-2 h-2 rounded-full bg-solar-400 animate-pulse"></span> LoRa 915MHz Active
          </span>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
          
          <!-- Node 1 -->
          <div class="bg-slate-900/90 rounded-xl p-4 border border-slate-800 space-y-2 relative overflow-hidden">
            <div class="flex items-center justify-between">
              <span class="font-bold text-xs text-slate-200">Node #01: Atok Farm Unit</span>
              <span class="text-[10px] bg-agri-950 text-agri-400 px-2 py-0.5 rounded border border-agri-800">Master Sender</span>
            </div>
            <div class="text-xs text-slate-400 space-y-1 font-mono">
              <div>Temp: <span class="text-agri-400 font-bold">4.8°C</span> | Storage: <span class="text-white font-bold">85/150 kg</span></div>
              <div>RSSI: <span class="text-slate-300">-84 dBm</span> | Status: <span class="text-emerald-400">Cold Chain Active</span></div>
            </div>
            <div class="text-[10px] text-slate-500 pt-2 border-t border-slate-800 flex justify-between">
              <span>Payload: #4802-ATK</span>
              <span>Broadcast: 2s ago</span>
            </div>
          </div>

          <!-- Node 2 -->
          <div class="bg-slate-900/90 rounded-xl p-4 border border-slate-800 space-y-2">
            <div class="flex items-center justify-between">
              <span class="font-bold text-xs text-slate-200">Node #02: La Trinidad Node</span>
              <span class="text-[10px] bg-blue-950 text-blue-400 px-2 py-0.5 rounded border border-blue-800">Relay Hop 1</span>
            </div>
            <div class="text-xs text-slate-400 space-y-1 font-mono">
              <div>Temp: <span class="text-agri-400 font-bold">5.2°C</span> | Storage: <span class="text-white font-bold">120/150 kg</span></div>
              <div>RSSI: <span class="text-slate-300">-91 dBm</span> | Status: <span class="text-emerald-400">Cold Chain Active</span></div>
            </div>
            <div class="text-[10px] text-slate-500 pt-2 border-t border-slate-800 flex justify-between">
              <span>Payload: #4803-LTR</span>
              <span>Broadcast: 1s ago</span>
            </div>
          </div>

          <!-- Node 3 Hub -->
          <div class="bg-slate-900/90 rounded-xl p-4 border border-solar-500/30 space-y-2">
            <div class="flex items-center justify-between">
              <span class="font-bold text-xs text-solar-300">Hub #03: Dispatch Center</span>
              <span class="text-[10px] bg-solar-950 text-solar-400 px-2 py-0.5 rounded border border-solar-800">Central Receiver</span>
            </div>
            <div class="text-xs text-slate-400 space-y-1 font-mono">
              <div>Pooled Capacity: <span class="text-solar-400 font-bold">205 kg / 300 kg</span></div>
              <div>Combined Reefer Readiness: <span class="text-emerald-400 font-bold">94%</span></div>
            </div>
            <div class="text-[10px] text-slate-500 pt-2 border-t border-slate-800 flex justify-between">
              <span>Truck Dispatch Status:</span>
              <span class="text-solar-400 font-bold">Optimized Route Ready</span>
            </div>
          </div>

        </div>
      </div>

    </section>

  </main>

  <script>
    // Global State
    let isDark = true;
    let isSimRunning = true;
    let simInterval = null;
    let solarMode = 'day'; // 'day' or 'night'
    let ambientTemp = 32;
    let cargoLoad = 50;
    let isPcmActive = true;

    // Live Metrics
    let currentInternalTemp = 4.8;
    let currentSolarWatts = 180;
    let currentPowerDraw = 65;
    let pcmChargePercent = 88;

    // Telemetry Chart Setup
    let telemetryChart = null;
    const chartTimeLabels = [];
    const tempDataPoints = [];
    const solarDataPoints = [];

    // Initialize Application
    window.onload = function() {
      lucide.createIcons();
      initChart();
      startSimulation();
    };

    // Tab Switch Logic
    function switchTab(tabId) {
      document.querySelectorAll('.tab-content').forEach(el => el.classList.add('hidden'));
      document.getElementById(tabId).classList.remove('hidden');

      document.querySelectorAll('.nav-btn').forEach(btn => {
        btn.classList.remove('text-agri-400', 'bg-agri-950/60', 'border', 'border-agri-500/30');
        btn.classList.add('text-slate-400');
      });

      const activeBtn = document.getElementById('btn-' + tabId);
      if (activeBtn) {
        activeBtn.classList.remove('text-slate-400');
        activeBtn.classList.add('text-agri-400', 'bg-agri-950/60', 'border', 'border-agri-500/30');
      }

      // Re-render Lucide icons inside active tab
      lucide.createIcons();
    }

    // Toggle Theme
    function toggleTheme() {
      isDark = !isDark;
      const body = document.getElementById('appBody');
      if (isDark) {
        body.classList.add('dark');
        body.classList.remove('bg-slate-100', 'text-slate-900');
        body.classList.add('bg-slate-950', 'text-slate-100');
      } else {
        body.classList.remove('dark');
        body.classList.remove('bg-slate-950', 'text-slate-100');
        body.classList.add('bg-slate-100', 'text-slate-900');
      }
    }

    // Initialize Chart.js
    function initChart() {
      const ctx = document.getElementById('telemetryChart').getContext('2d');
      
      // Initial Mock Time
      for (let i = 10; i >= 0; i--) {
        chartTimeLabels.push(i + 's ago');
        tempDataPoints.push(4.8 + (Math.random() * 0.4 - 0.2));
        solarDataPoints.push(180);
      }

      telemetryChart = new Chart(ctx, {
        type: 'line',
        data: {
          labels: chartTimeLabels,
          datasets: [
            {
              label: 'Internal Storage (°C)',
              data: tempDataPoints,
              borderColor: '#22c55e',
              backgroundColor: 'rgba(34, 197, 94, 0.1)',
              borderWidth: 2,
              tension: 0.3,
              yAxisID: 'yTemp',
              fill: true,
            },
            {
              label: 'Solar Output (W)',
              data: solarDataPoints,
              borderColor: '#f59e0b',
              borderDash: [4, 4],
              borderWidth: 1.5,
              tension: 0.1,
              yAxisID: 'ySolar',
            }
          ]
        },
        options: {
          responsive: true,
          maintainAspectRatio: false,
          scales: {
            x: {
              grid: { color: 'rgba(255,255,255,0.05)' },
              ticks: { color: '#94a3b8', font: { size: 10 } }
            },
            yTemp: {
              type: 'linear',
              position: 'left',
              min: 0,
              max: 20,
              grid: { color: 'rgba(255,255,255,0.05)' },
              ticks: { color: '#22c55e', font: { size: 10 } },
              title: { display: true, text: 'Temp (°C)', color: '#22c55e', font: { size: 10 } }
            },
            ySolar: {
              type: 'linear',
              position: 'right',
              min: 0,
              max: 250,
              grid: { drawOnChartArea: false },
              ticks: { color: '#f59e0b', font: { size: 10 } },
              title: { display: true, text: 'Solar (W)', color: '#f59e0b', font: { size: 10 } }
            }
          },
          plugins: {
            legend: {
              labels: { color: '#cbd5e1', font: { size: 11 } }
            }
          }
        }
      });
    }

    // Simulation Controls Handler
    function updateSimControls() {
      ambientTemp = parseFloat(document.getElementById('input-ambient').value);
      cargoLoad = parseFloat(document.getElementById('input-cargo').value);
      isPcmActive = document.getElementById('chk-pcm').checked;

      document.getElementById('lbl-ambient-temp').innerText = ambientTemp + ' °C';
      document.getElementById('lbl-cargo-load').innerText = cargoLoad + ' kg';
    }

    function setSolarMode(mode) {
      solarMode = mode;
      const dayBtn = document.getElementById('btn-mode-day');
      const nightBtn = document.getElementById('btn-mode-night');
      const txtMode = document.getElementById('txt-solar-mode');

      if (mode === 'day') {
        txtMode.innerText = 'Peak Sun (12:00 PM)';
        txtMode.className = 'font-bold text-solar-400';
        dayBtn.className = 'text-xs py-2 rounded-lg bg-solar-500/20 border border-solar-500/40 text-solar-300 font-semibold flex items-center justify-center gap-2';
        nightBtn.className = 'text-xs py-2 rounded-lg bg-slate-900 border border-slate-800 text-slate-400 hover:text-white flex items-center justify-center gap-2';
      } else {
        txtMode.innerText = 'Night Cycle (00:00 AM)';
        txtMode.className = 'font-bold text-blue-400';
        nightBtn.className = 'text-xs py-2 rounded-lg bg-blue-500/20 border border-blue-500/40 text-blue-300 font-semibold flex items-center justify-center gap-2';
        dayBtn.className = 'text-xs py-2 rounded-lg bg-slate-900 border border-slate-800 text-slate-400 hover:text-white flex items-center justify-center gap-2';
      }
    }

    // Start Real-Time Simulation Loop
    function startSimulation() {
      if (simInterval) clearInterval(simInterval);
      simInterval = setInterval(() => {
        if (!isSimRunning) return;

        // Compute Solar Input
        if (solarMode === 'day') {
          currentSolarWatts = Math.min(220, 180 + (Math.random() * 20 - 10));
          currentPowerDraw = 65;
          // Charge PCM
          pcmChargePercent = Math.min(100, pcmChargePercent + 0.5);
        } else {
          currentSolarWatts = 0;
          currentPowerDraw = 0; // Solar off
          // Discharge PCM
          if (isPcmActive) {
            pcmChargePercent = Math.max(10, pcmChargePercent - 0.8);
          }
        }

        // Calculate Target Internal Temperature
        let targetTemp = 4.5;
        
        // Heat load from ambient
        const heatLeakage = (ambientTemp - 20) * 0.08;
        const cargoInertia = cargoLoad * 0.02;

        if (solarMode === 'day') {
          targetTemp = 4.0 + heatLeakage + cargoInertia * 0.1;
        } else {
          // Night condition
          if (isPcmActive && pcmChargePercent > 15) {
            targetTemp = 5.2 + heatLeakage * 0.5; // PCM maintains thermal stability
          } else {
            targetTemp = ambientTemp - 2.0; // Without PCM, warms quickly
          }
        }

        // Smooth Temperature Drift
        currentInternalTemp += (targetTemp - currentInternalTemp) * 0.15 + (Math.random() * 0.1 - 0.05);

        // Update Gauge UI
        document.getElementById('metric-solar').innerText = Math.round(currentSolarWatts) + ' W';
        document.getElementById('metric-internal-temp').innerText = currentInternalTemp.toFixed(1) + ' °C';
        document.getElementById('metric-power-draw').innerText = Math.round(currentPowerDraw) + ' W';

        const pcmElem = document.getElementById('metric-pcm-state');
        if (pcmChargePercent > 50) {
          pcmElem.innerText = 'Solid / ' + Math.round(pcmChargePercent) + '%';
          pcmElem.className = 'text-lg font-bold text-blue-400';
        } else if (pcmChargePercent > 20) {
          pcmElem.innerText = 'Phase Shift / ' + Math.round(pcmChargePercent) + '%';
          pcmElem.className = 'text-lg font-bold text-solar-400';
        } else {
          pcmElem.innerText = 'Liquid / ' + Math.round(pcmChargePercent) + '%';
          pcmElem.className = 'text-lg font-bold text-rose-400';
        }

        const targetStatus = document.getElementById('status-target');
        if (currentInternalTemp >= 2.0 && currentInternalTemp <= 8.0) {
          targetStatus.innerText = 'Optimal (2°C - 8°C)';
          targetStatus.className = 'text-[10px] text-emerald-400 font-medium';
        } else {
          targetStatus.innerText = 'Warning: Temp Excursion';
          targetStatus.className = 'text-[10px] text-rose-400 font-bold';
        }

        // Update Chart
        if (telemetryChart) {
          chartTimeLabels.shift();
          chartTimeLabels.push(new Date().toLocaleTimeString().split(' ')[0]);
          tempDataPoints.shift();
          tempDataPoints.push(parseFloat(currentInternalTemp.toFixed(1)));
          solarDataPoints.shift();
          solarDataPoints.push(Math.round(currentSolarWatts));

          telemetryChart.update('none');
        }

      }, 1500);
    }

    function toggleSimulation() {
      isSimRunning = !isSimRunning;
      const btn = document.getElementById('btn-toggle-sim');
      if (isSimRunning) {
        btn.innerHTML = `<i data-lucide="pause" class="w-3.5 h-3.5 fill-current"></i> Pause Sim`;
        btn.className = 'text-xs bg-agri-500 hover:bg-agri-400 text-slate-950 font-bold px-3 py-1.5 rounded-lg flex items-center gap-1 shadow';
      } else {
        btn.innerHTML = `<i data-lucide="play" class="w-3.5 h-3.5 fill-current"></i> Resume Sim`;
        btn.className = 'text-xs bg-solar-500 hover:bg-solar-400 text-slate-950 font-bold px-3 py-1.5 rounded-lg flex items-center gap-1 shadow';
      }
      lucide.createIcons();
    }

    function resetSimulation() {
      currentInternalTemp = 4.8;
      pcmChargePercent = 88;
      setSolarMode('day');
      document.getElementById('input-ambient').value = 32;
      document.getElementById('input-cargo').value = 50;
      document.getElementById('chk-pcm').checked = true;
      updateSimControls();
    }
  </script>

</body>
</html>
